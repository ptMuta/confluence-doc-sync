                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Realizes "
                    },
                    {
                      "type": "text",
                      "text": "ADR-012 Keep data off the internet",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://example.atlassian.net/wiki/pages/ADR-012"
                          }
                        }
