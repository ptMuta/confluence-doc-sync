        <mxCell id="srv" value="Servers" style="role=device;shape=mxgraph.cisco19.rect;prIcon=ucs_c_series_server;" vertex="1" parent="site"><mxGeometry x="640" y="280" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="n1" value="" style="role=flow;" edge="1" parent="1" source="internet" target="fw"><mxGeometry relative="1" as="geometry" /></mxCell>
