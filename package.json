{
  "name": "git-confluence-sync",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --check .",
    "test": "vitest run --coverage",
    "knip": "knip",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run knip && npm run build"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
