<mxfile>
  <diagram id="architecture" name="Docs sync architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="author" value="Author" style="role=actor;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="github" value="GitHub repository" style="role=zone;" vertex="1" parent="1">
          <mxGeometry x="140" y="40" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="docs" value="Docs and diagrams on main" style="role=data-store;" vertex="1" parent="github">
          <mxGeometry x="30" y="217" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pr" value="Pull requests: no token" style="role=boundary;" vertex="1" parent="github">
          <mxGeometry x="200" y="45" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="check" value="check: lint and render" style="role=service;icon=git-pull-request;" vertex="1" parent="pr">
          <mxGeometry x="20" y="35" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="planzone" value="docs-sync-read: read token" style="role=boundary;" vertex="1" parent="github">
          <mxGeometry x="200" y="195" width="410" height="120" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="plan: compare with Confluence" style="role=service;icon=list-check;" vertex="1" parent="planzone">
          <mxGeometry x="20" y="40" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bundle" value="Plan bundle and hash" style="role=queue;icon=package;" vertex="1" parent="planzone">
          <mxGeometry x="240" y="42" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pubzone" value="docs-sync-publish-low-risk: write token and ownership key" style="role=boundary;" vertex="1" parent="github">
          <mxGeometry x="200" y="355" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="Checks hash, commit, config, visibility and signed ownership" style="role=note;" vertex="1" parent="pubzone">
          <mxGeometry x="20" y="35" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="publish: apply the bundle" style="role=service;icon=upload;" vertex="1" parent="pubzone">
          <mxGeometry x="230" y="45" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="confluence" value="Confluence Cloud" style="role=zone;" vertex="1" parent="1">
          <mxGeometry x="860" y="40" width="240" height="500" as="geometry" />
        </mxCell>
        <mxCell id="external" value="External decisions" style="role=data-store;" vertex="1" parent="confluence">
          <mxGeometry x="55" y="130" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="Synced pages under the root" style="role=data-store;" vertex="1" parent="confluence">
          <mxGeometry x="55" y="382" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="draw.io renders inside the action container, as a non-root user with no token in its environment." style="role=text;" vertex="1" parent="1">
          <mxGeometry x="140" y="555" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="pull request" edge="1" parent="1" source="author" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="merge" style="exitX=1;exitY=0.9;exitDx=0;exitDy=0;" edge="1" parent="1" source="author" target="docs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="164" />
              <mxPoint x="110" y="302" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="push" edge="1" parent="1" source="docs" target="plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="role=flow-async;" edge="1" parent="1" source="plan" target="bundle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="role=flow-async;" edge="1" parent="1" source="bundle" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="resolve references" style="exitX=0.9;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="plan" target="external">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="522" y="215" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="read pages" style="entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="pages">
          <mxGeometry x="0.45" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="375" />
              <mxPoint x="980" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="write" edge="1" parent="1" source="publish" target="pages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
